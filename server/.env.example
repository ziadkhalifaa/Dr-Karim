# Phase 2 backend configuration (MySQL 8+, Hostinger Business Node.js Web App)
# Copy to .env and fill in real values. NEVER commit .env.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dr_kareem
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_LOGGING=false
DB_CHARSET=utf8mb4

# HTTP Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS — comma-separated list of allowed frontend origins.
# Default (dev) allows Vite dev server on 5173 and 4173.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Tenant resolution (default slug dr-kareem; override with X-Tenant-Slug header)
DEFAULT_TENANT_SLUG=dr-kareem

# Trust reverse proxy for correct req.ip when behind Hostinger proxy
TRUST_PROXY=false

# JSON body size limit (assessment payloads are small; 256kb is plenty)
JSON_BODY_LIMIT=256kb

# Consent policy version (stored on consent_contact_at)
CONSENT_POLICY_VERSION=1.0

# Authentication. Required in production; X-Tenant-Slug is development-only.
AUTH_REQUIRED=true
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=900
# One-time doctor account creation token. Leave empty to disable /health/init-doctor.
# Set a random value, use it once via `Authorization: Bearer <token>`, then remove it.
AUTH_SETUP_TOKEN=

# Daily.co integration. Use mock for local development; production requires a secret.
DAILY_PROVIDER_MODE=mock
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_ROOM_TTL_SECONDS=7200
DAILY_TOKEN_TTL_SECONDS=3600
